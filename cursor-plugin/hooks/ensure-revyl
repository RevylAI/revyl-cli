#!/bin/sh
#
# Reports plugin runtime readiness, installs the pinned CLI when allowed, and
# bridges an injected API key or tells the agent how to sign in.

RUNTIME_UNAVAILABLE_MESSAGE='The Revyl plugin runtime is not ready. Update or reinstall the plugin, or set REVYL_BINARY to an executable Revyl CLI path.'
LOGIN_GUIDANCE='Run revyl auth login and post the printed approval URL as a clickable markdown link. Wait for approval. REVYL_API_KEY is optional for unattended agents.'
INSTALL_ON_FIRST_COMMAND='The Revyl CLI installs on the first revyl command.'

# plugin_directory returns the logical install root instead of a linked source root.
plugin_directory() {
  if [ -n "${CURSOR_PLUGIN_ROOT:-}" ] &&
    [ "$CURSOR_PLUGIN_ROOT" != '${CURSOR_PLUGIN_ROOT}' ] &&
    [ -d "$CURSOR_PLUGIN_ROOT" ]; then
    CDPATH= cd -L -- "$CURSOR_PLUGIN_ROOT" && pwd -L
    return
  fi

  script_directory=$(CDPATH= cd -L -- "$(dirname -- "$0")" && pwd -L)
  CDPATH= cd -L -- "$script_directory/.." && pwd -L
}

PLUGIN_DIR=$(plugin_directory)
MANIFEST_PATH="$PLUGIN_DIR/runtime-manifest.json"
LAUNCHER="$PLUGIN_DIR/hooks/launch-revyl"

INPUT=$(cat 2>/dev/null) || INPUT=''
EVENT=$(printf '%s' "$INPUT" | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

# emit MESSAGE returns only fields supported by the active Cursor hook event.
emit() {
  case "$EVENT" in
    beforeShellExecution)
      if [ -n "$1" ]; then
        printf '{"permission":"allow","agent_message":"%s"}\n' "$1"
      else
        printf '{"permission":"allow"}\n'
      fi
      ;;
    sessionStart)
      if [ -n "$1" ]; then
        printf '{"additional_context":"%s"}\n' "$1"
      else
        printf '{}\n'
      fi
      ;;
    *)
      printf '{}\n'
      ;;
  esac
  exit 0
}

case "$EVENT" in
  beforeShellExecution|sessionStart) ;;
  *) emit '' ;;
esac

# Ignore Cloud interpolations that were stored as literal text.
if [ "${REVYL_API_KEY:-}" = '${env:REVYL_API_KEY}' ]; then
  unset REVYL_API_KEY
fi
if [ "${REVYL_BINARY:-}" = '${env:REVYL_BINARY}' ]; then
  unset REVYL_BINARY
fi

# usable_api_key reports whether the environment holds a real credential.
usable_api_key() {
  [ -n "${REVYL_API_KEY:-}" ]
}

# runtime_ready verifies either an explicit override or a prepared bundled manifest.
runtime_ready() {
  if [ -n "${REVYL_BINARY:-}" ]; then
    if command -v "$REVYL_BINARY" >/dev/null 2>&1; then
      return 0
    fi
    [ -f "$REVYL_BINARY" ] && [ -x "$REVYL_BINARY" ]
    return
  fi

  [ -f "$MANIFEST_PATH" ] || return 1
  grep -Eq '"prepared"[[:space:]]*:[[:space:]]*true' "$MANIFEST_PATH" ||
    return 1

  case "$(uname -s 2>/dev/null || true):$(uname -m 2>/dev/null || true)" in
    Darwin:x86_64|Darwin:amd64|Darwin:arm64|Darwin:aarch64) ;;
    Linux:x86_64|Linux:amd64|Linux:arm64|Linux:aarch64) ;;
    *) return 1 ;;
  esac

  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 ||
    return 1
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1
}

# invoke_launcher runs the pinned runtime with the given argv.
invoke_launcher() {
  no_download=$1
  shift
  REVYL_RUNTIME_NO_DOWNLOAD="$no_download" \
    REVYL_TELEMETRY_DISABLED=1 \
    REVYL_NO_UPDATE_NOTIFIER=1 \
    "$LAUNCHER" "$@" >/dev/null 2>&1
}

# ensure_runtime downloads or resolves the pin via a cheap CLI command.
ensure_runtime() {
  invoke_launcher "$1" version
}

# persist_key writes an injected REVYL_API_KEY into the CLI credential store.
persist_key() {
  invoke_launcher '' auth persist-cloud-env
}

if ! runtime_ready; then
  emit "$RUNTIME_UNAVAILABLE_MESSAGE"
fi

# event × has_key -> ensure_mode persist fail_message success_message
ensure_mode=none
do_persist=0
fail_message=$LOGIN_GUIDANCE
success_message=$LOGIN_GUIDANCE
if [ "$EVENT" = sessionStart ]; then
  if usable_api_key; then
    ensure_mode=nodownload
    do_persist=1
    fail_message=$INSTALL_ON_FIRST_COMMAND
    success_message=
  fi
else
  ensure_mode=download
  if usable_api_key; then
    do_persist=1
    fail_message=$RUNTIME_UNAVAILABLE_MESSAGE
    success_message=
  fi
fi

if [ "$ensure_mode" = nodownload ]; then
  if ! ensure_runtime 1; then
    emit "$fail_message"
  fi
elif [ "$ensure_mode" = download ]; then
  if [ "$do_persist" -eq 0 ]; then
    ensure_runtime '' || true
  elif ! ensure_runtime ''; then
    emit "$fail_message"
  fi
fi

if [ "$do_persist" -eq 1 ]; then
  if ! persist_key; then
    emit "$fail_message"
  fi
fi

emit "$success_message"
